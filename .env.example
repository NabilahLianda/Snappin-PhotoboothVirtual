# Salin file ini menjadi `.env.local` lalu isi nilainya.

# ---------------------------------------------------------------------------
# TURN server (opsional, tapi SANGAT disarankan)
# ---------------------------------------------------------------------------
# Tanpa TURN, dua device hanya bisa tersambung kalau keduanya bisa saling
# menjangkau langsung. Untuk koneksi antar-jaringan (beda kota, data seluler,
# Wi-Fi dengan "client isolation", VPN, dsb.) server TURN hampir selalu wajib
# supaya video & foto bisa mengalir lewat relay.
#
# Lihat indikator "TURN: aktif/tidak" di bawah video pada halaman room.

# --- Opsi 1: kredensial statis (paling sederhana) -------------------------
# Ambil dari dashboard penyedia (mis. expressTURN / Metered). Beberapa URL
# dipisah koma.
NEXT_PUBLIC_TURN_URL=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""

# --- Opsi 2: endpoint kredensial dinamis --------------------------------
# Kalau penyedia memberi URL REST API yang mengembalikan array iceServers,
# isi ini (kredensial akan diambil otomatis & bisa kedaluwarsa).
# Contoh Metered:
#   NEXT_PUBLIC_TURN_CREDENTIALS_URL="https://namamu.metered.live/api/v1/turn/credentials?apiKey=API_KEY"
NEXT_PUBLIC_TURN_CREDENTIALS_URL=""
